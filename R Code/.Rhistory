library(survey)
install.packages("survey")
# 04_estimation.R
# Section D: design-based estimation with the survey package.
# Stratified sample (Neyman allocation by region) against an SRSWOR
# benchmark of the same size.
#
# Run 01 to 03 first; this script reads data/population.csv and
# data/sample.csv. D7 (empirical against estimated SE) needs repeated
# samples and is done in the Section E simulation script.
library(survey)
population <- read.csv(file.path("data", "population.csv"))
smp        <- read.csv(file.path("data", "sample.csv"))
N         <- nrow(population)
rel_e     <- 0.05
resp_rate <- 0.90
true_mean <- mean(population$winnings_usd)
true_prop <- mean(population$below_ev)
dir.create("output", showWarnings = FALSE)
# Estimates are made from respondents only, using the
# non-response-adjusted weights N_h / r_h.
resp <- smp[smp$responded == 1, ]
# ---- D1: survey design objects --------------------------------------------
# Stratified: strata = region, weights = N_h / r_h, fpc = N_h
des_str <- svydesign(ids = ~1, strata = ~stratum_id, weights = ~w_final,
fpc = ~N_h, data = resp)
# SRSWOR benchmark: select the same number of contestants as the
# stratified sample, apply the same response rate, weights N / r
set.seed(20261021)
srs_sel <- population[sample.int(N, nrow(smp)), ]
srs_sel$responded <- rbinom(nrow(srs_sel), 1, resp_rate)
srs <- srs_sel[srs_sel$responded == 1, ]
srs$N_pop   <- N
srs$w_final <- N / nrow(srs)
des_srs <- svydesign(ids = ~1, weights = ~w_final, fpc = ~N_pop, data = srs)
write.csv(srs_sel, file.path("data", "sample_srswor.csv"), row.names = FALSE)
# ---- D2 and D3: estimates -------------------------------------------------
summarise_est <- function(design, var, true_value, design_name) {
est <- svymean(as.formula(paste0("~", var)), design, deff = TRUE)
ci  <- confint(est)
se  <- as.numeric(SE(est))
data.frame(
design          = design_name,
parameter       = var,
n_respondents   = nrow(design$variables),
estimate        = as.numeric(coef(est)),
variance        = se^2,
se              = se,
ci_lower        = ci[1, 1],
ci_upper        = ci[1, 2],
cv              = se / as.numeric(coef(est)),
deff            = as.numeric(deff(est)),
half_width      = (ci[1, 2] - ci[1, 1]) / 2,
target_hw       = rel_e * true_value,
true_value      = true_value,
ci_covers_truth = ci[1, 1] <= true_value & true_value <= ci[1, 2]
)
}
results <- rbind(
summarise_est(des_str, "winnings_usd", true_mean, "Stratified (Neyman)"),
summarise_est(des_srs, "winnings_usd", true_mean, "SRSWOR"),
summarise_est(des_str, "below_ev",     true_prop, "Stratified (Neyman)"),
summarise_est(des_srs, "below_ev",     true_prop, "SRSWOR")
)
results$meets_5pct <- results$half_width <= results$target_hw
print(results, digits = 4)
# Estimates within each region
print(svyby(~winnings_usd + below_ev, ~region, des_str, svymean))
# ---- D4: inclusion probabilities and weights ------------------------------
# pi_i = n_h / N_h is the chance a contestant in region h is selected;
# w_design = 1 / pi_i is how many population members each selected
# contestant represents. After non-response, w_final = N_h / r_h spreads
# each region's total over its respondents only.
weights_table <- unique(smp[, c("region", "N_h", "n_h", "pi_i", "w_design",
"r_h", "w_final")])
weights_table <- weights_table[weights_table$w_final > 0, ]
print(weights_table)
# ---- D5: naive against design-adjusted against true -----------------------
# The naive mean ignores the weights. The US is sampled at a higher rate
# than its population share, so the naive mean is pulled towards the US.
comparison <- data.frame(
parameter       = c("Mean winnings (USD)", "Proportion below opening EV"),
naive           = c(mean(resp$winnings_usd), mean(resp$below_ev)),
design_adjusted = results$estimate[results$design == "Stratified (Neyman)"],
true_value      = c(true_mean, true_prop)
)
comparison$naive_error    <- comparison$naive - comparison$true_value
comparison$adjusted_error <- comparison$design_adjusted - comparison$true_value
print(comparison, digits = 4)
# ---- D6 and D8: precision of the two designs ------------------------------
precision <- data.frame(
parameter = c("Mean winnings", "Proportion below opening EV"),
se_strat  = results$se[results$design == "Stratified (Neyman)"],
se_srswor = results$se[results$design == "SRSWOR"]
)
precision$variance_ratio <- precision$se_strat^2 / precision$se_srswor^2
print(precision, digits = 4)
write.csv(results,    file.path("output", "D_estimates.csv"),      row.names = FALSE)
write.csv(comparison, file.path("output", "D_naive_vs_design.csv"), row.names = FALSE)
View(weights_table)
# 05_simulation.R
# Section E (and D7): repeat the whole sampling and estimation procedure
# R times for the stratified design and the SRSWOR benchmark.
#
# Each repetition: select the sample, simulate non-response, re-weight,
# estimate the mean and the proportion with their SEs and 95% CIs.
# The estimators are written out in closed form for speed; the first
# repetition is checked against the survey package to confirm they match.
#
# Run 01 to 03 first; this script reads data/population.csv and
# data/sample.csv (for the stratum sample sizes).
library(survey)
library(ggplot2)
set.seed(20261022)
R         <- 1000
resp_rate <- 0.90
rel_e     <- 0.05
z         <- qnorm(0.975)
population <- read.csv(file.path("data", "population.csv"))
smp        <- read.csv(file.path("data", "sample.csv"))
N         <- nrow(population)
true_mean <- mean(population$winnings_usd)
true_prop <- mean(population$below_ev)
# Stratum sizes and sample sizes, as used in Section C
alloc <- unique(smp[, c("region", "N_h", "n_h")])
n_total <- sum(alloc$n_h)
rows_by_region <- split(seq_len(N), population$region)
dir.create("output",  showWarnings = FALSE)
dir.create("figures", showWarnings = FALSE)
# ---- Estimators -----------------------------------------------------------
# Stratified mean and variance from respondents:
# ybar_st = sum W_h ybar_h,  v = sum W_h^2 (1 - r_h / N_h) s_h^2 / r_h
est_strat <- function(y, region, N_h) {
W_h  <- N_h / sum(N_h)
ybar <- tapply(y, region, mean)[names(N_h)]
s2   <- tapply(y, region, var)[names(N_h)]
r_h  <- tapply(y, region, length)[names(N_h)]
c(est = sum(W_h * ybar),
se  = sqrt(sum(W_h^2 * (1 - r_h / N_h) * s2 / r_h)))
}
# SRSWOR mean and variance from respondents: v = (1 - r / N) s^2 / r
est_srs <- function(y, N) {
r <- length(y)
c(est = mean(y), se = sqrt((1 - r / N) * var(y) / r))
}
N_h <- setNames(alloc$N_h, alloc$region)
# ---- One repetition -------------------------------------------------------
one_rep <- function() {
# Stratified: SRSWOR of n_h within each region, then non-response
sel <- unlist(lapply(alloc$region, function(h) {
rows <- rows_by_region[[h]]
rows[sample.int(length(rows), alloc$n_h[alloc$region == h])]
}))
sel  <- sel[rbinom(length(sel), 1, resp_rate) == 1]
d    <- population[sel, ]
st_m <- est_strat(d$winnings_usd, d$region, N_h)
st_p <- est_strat(d$below_ev,     d$region, N_h)
# SRSWOR benchmark of the same selected size, same response rate
sel2 <- sample.int(N, n_total)
sel2 <- sel2[rbinom(length(sel2), 1, resp_rate) == 1]
d2   <- population[sel2, ]
sr_m <- est_srs(d2$winnings_usd, N)
sr_p <- est_srs(d2$below_ev,     N)
rbind(
data.frame(design = "Stratified (Neyman)", parameter = "Mean winnings",
est = st_m[["est"]], se = st_m[["se"]], n_resp = nrow(d)),
data.frame(design = "SRSWOR", parameter = "Mean winnings",
est = sr_m[["est"]], se = sr_m[["se"]], n_resp = nrow(d2)),
data.frame(design = "Stratified (Neyman)", parameter = "Proportion below opening EV",
est = st_p[["est"]], se = st_p[["se"]], n_resp = nrow(d)),
data.frame(design = "SRSWOR", parameter = "Proportion below opening EV",
est = sr_p[["est"]], se = sr_p[["se"]], n_resp = nrow(d2))
)
}
# ---- Check the closed-form estimator against the survey package -----------
resp <- smp[smp$responded == 1, ]
des  <- svydesign(ids = ~1, strata = ~stratum_id, weights = ~w_final,
fpc = ~N_h, data = resp)
chk_survey <- svymean(~winnings_usd, des)
chk_manual <- est_strat(resp$winnings_usd, resp$region, N_h)
stopifnot(abs(coef(chk_survey) - chk_manual[["est"]]) < 1e-6,
abs(SE(chk_survey)   - chk_manual[["se"]])  < 1e-6)
# ---- E1 and E2: repeat R times --------------------------------------------
reps <- do.call(rbind, lapply(seq_len(R), function(i) cbind(rep = i, one_rep())))
reps$lower <- reps$est - z * reps$se
reps$upper <- reps$est + z * reps$se
reps$true  <- ifelse(reps$parameter == "Mean winnings", true_mean, true_prop)
write.csv(reps, file.path("output", "E_replicates.csv"), row.names = FALSE)
# ---- E3 to E5 and D7: performance measures --------------------------------
perf <- do.call(rbind, lapply(split(reps, list(reps$design, reps$parameter)),
function(d) {
true     <- d$true[1]
coverage <- mean(d$lower <= true & true <= d$upper)
data.frame(
design         = d$design[1],
parameter      = d$parameter[1],
true_value     = true,
mean_estimate  = mean(d$est),
bias           = mean(d$est) - true,
relative_bias  = (mean(d$est) - true) / true,
empirical_se   = sd(d$est),
avg_estimated_se = mean(d$se),
rmse           = sqrt(mean((d$est - true)^2)),
coverage       = coverage,
mc_se_coverage = sqrt(coverage * (1 - coverage) / nrow(d)),
avg_ci_width   = mean(d$upper - d$lower),
pct_meeting_5pct = mean(z * d$se <= rel_e * true)
)
}))
rownames(perf) <- NULL
# Empirical design effect: variance of the stratified estimates over
# variance of the SRSWOR estimates
perf$empirical_deff <- NA
for (p in unique(perf$parameter)) {
v_st  <- perf$empirical_se[perf$parameter == p & perf$design == "Stratified (Neyman)"]^2
v_srs <- perf$empirical_se[perf$parameter == p & perf$design == "SRSWOR"]^2
perf$empirical_deff[perf$parameter == p & perf$design == "Stratified (Neyman)"] <- v_st / v_srs
perf$empirical_deff[perf$parameter == p & perf$design == "SRSWOR"] <- 1
}
print(perf, digits = 4)
write.csv(perf, file.path("output", "E_performance.csv"), row.names = FALSE)
# ---- Figures --------------------------------------------------------------
p_dist <- ggplot(reps, aes(est, fill = design)) +
geom_density(alpha = 0.4) +
geom_vline(aes(xintercept = true), linetype = "dashed") +
facet_wrap(~parameter, scales = "free") +
labs(x = "Estimate", y = "Density", fill = "Design",
title = paste("Sampling distribution of the estimates over", R, "repetitions")) +
theme_minimal()
ggsave(file.path("figures", "E_sampling_distributions.png"), p_dist, width = 9, height = 4.5)
# First 100 confidence intervals for the mean under each design
ci_plot <- reps[reps$parameter == "Mean winnings" & reps$rep <= 100, ]
ci_plot$covers <- ci_plot$lower <= ci_plot$true & ci_plot$true <= ci_plot$upper
p_ci <- ggplot(ci_plot, aes(rep, est, ymin = lower, ymax = upper, colour = covers)) +
geom_pointrange(size = 0.15) +
geom_hline(yintercept = true_mean, linetype = "dashed") +
facet_wrap(~design) +
scale_colour_manual(values = c(`TRUE` = "grey40", `FALSE` = "red")) +
labs(x = "Repetition", y = "Mean winnings (USD)", colour = "Covers true mean",
title = "95% confidence intervals for mean winnings, first 100 repetitions") +
theme_minimal()
ggsave(file.path("figures", "E_confidence_intervals.png"), p_ci, width = 9, height = 4.5)
# 06_extra_figures.R
# Four additional figures for the report:
#   A_winnings_by_region.png      - distribution of winnings by region (A5, A6)
#   A_banker_offer_curve.png      - banker offer as % of expected value (A5)
#   B_allocation_comparison.png   - n needed under each allocation (B5)
#   E_half_width_distribution.png - realised CI half-widths vs the 5% target (E, D8)
#
# Run 01 to 05 first; this script reads data/population.csv and
# output/E_replicates.csv. It draws no random numbers.
library(ggplot2)
population <- read.csv(file.path("data", "population.csv"))
reps       <- read.csv(file.path("output", "E_replicates.csv"))
N     <- nrow(population)
z     <- qnorm(0.975)
rel_e <- 0.05
dir.create("figures", showWarnings = FALSE)
# ---- 1. Winnings by region ------------------------------------------------
# Log scale, because winnings run from cents to over a million dollars.
# Diamonds mark each region's mean; crosses mark the opening expected value.
region_means <- aggregate(winnings_usd ~ region, population, mean)
opening_ev   <- unique(population[, c("region", "opening_ev_usd")])
p1 <- ggplot(population, aes(region, winnings_usd)) +
geom_violin(fill = "grey85", colour = NA, scale = "width") +
geom_boxplot(width = 0.15, outlier.size = 0.4, outlier.alpha = 0.3) +
geom_point(data = region_means, shape = 23, size = 3, fill = "steelblue") +
geom_point(data = opening_ev, aes(y = opening_ev_usd), shape = 4, size = 3,
stroke = 1.2, colour = "firebrick") +
scale_y_log10(labels = scales::dollar, breaks = 10^(-2:6)) +
labs(x = "Region (stratum)", y = "Winnings (USD, log scale)",
title = "Distribution of winnings by region",
subtitle = "Blue diamond = mean winnings; red cross = opening expected value of the board") +
theme_minimal()
ggsave(file.path("figures", "A_winnings_by_region.png"), p1, width = 7, height = 4.5)
# ---- 2. Banker offer curve ------------------------------------------------
# Same rule as banker_fraction() in 01_simulate_population.R:
# base fraction 0.15 + 0.85 ((r - 1) / (R - 1))^1.5, multiplied by
# exp(N(0, 0.10^2)) noise and capped at 1.10. The band shows the middle 95%
# of that noise.
offer_curve <- function(show, R) {
r    <- seq_len(R)
base <- 0.15 + 0.85 * ((r - 1) / (R - 1))^1.5
data.frame(show  = show, round = r, base = base,
lower = base * exp(-z * 0.10),
upper = pmin(base * exp(z * 0.10), 1.10))
}
offers <- rbind(offer_curve("UK (6 rounds)", 6),
offer_curve("US and Australia (9 rounds)", 9))
p2 <- ggplot(offers, aes(round, base, colour = show, fill = show)) +
geom_ribbon(aes(ymin = lower, ymax = upper), alpha = 0.15, colour = NA) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
geom_hline(yintercept = 1, linetype = "dashed") +
scale_y_continuous(labels = scales::percent, limits = c(0, 1.15)) +
scale_x_continuous(breaks = 1:9) +
labs(x = "Round", y = "Offer as % of expected value of unopened boxes",
colour = "Show", fill = "Show",
title = "Banker offers rise towards the expected value as the game goes on",
subtitle = "Line = average offer; band = middle 95% of offers; dashed line = expected value") +
theme_minimal()
ggsave(file.path("figures", "A_banker_offer_curve.png"), p2, width = 7, height = 4.5)
# ---- 3. Required sample size under each allocation ------------------------
# For allocation shares a_h (n_h = n a_h), the variance of the stratified
# mean with fpc is  V = (1/n) sum W_h^2 S_h^2 / a_h - (1/N) sum W_h S_h^2,
# so the n that gives V = (e / z)^2 is
#   n = sum(W_h^2 S_h^2 / a_h) / ((e / z)^2 + sum(W_h S_h^2) / N).
strata <- do.call(rbind, lapply(split(population, population$region),
function(d) data.frame(
region = d$region[1],
N_h    = nrow(d),
S_h    = sd(d$winnings_usd),
Sp_h   = sqrt(nrow(d) / (nrow(d) - 1) * mean(d$below_ev) * (1 - mean(d$below_ev)))
)))
strata$W_h <- strata$N_h / N
n_alloc <- function(e, S_h, a_h) {
sum(strata$W_h^2 * S_h^2 / a_h) / ((e / z)^2 + sum(strata$W_h * S_h^2) / N)
}
n_srs <- function(e, S) {
n0 <- (z * S / e)^2
n0 / (1 + n0 / N)
}
# Allocation shares. The design uses Neyman allocation for the mean, so the
# proportion is shown under that same allocation.
shares <- list(
"Proportional"           = strata$W_h,
"Equal"                  = rep(1 / nrow(strata), nrow(strata)),
"Neyman for mean (used)" = strata$N_h * strata$S_h / sum(strata$N_h * strata$S_h)
)
e_mean <- rel_e * mean(population$winnings_usd)
e_prop <- rel_e * mean(population$below_ev)
S_p    <- sqrt(N / (N - 1) * mean(population$below_ev) * (1 - mean(population$below_ev)))
alloc <- rbind(
data.frame(parameter = "Mean winnings", design = "SRSWOR",
n = n_srs(e_mean, sd(population$winnings_usd))),
data.frame(parameter = "Mean winnings", design = names(shares),
n = sapply(shares, n_alloc, e = e_mean, S_h = strata$S_h)),
data.frame(parameter = "Proportion below opening EV", design = "SRSWOR",
n = n_srs(e_prop, S_p)),
data.frame(parameter = "Proportion below opening EV", design = names(shares),
n = sapply(shares, n_alloc, e = e_prop, S_h = strata$Sp_h))
)
alloc$n      <- ceiling(alloc$n)
alloc$design <- factor(alloc$design, levels = c("SRSWOR", names(shares)))
alloc$used   <- alloc$design == "Neyman for mean (used)"
print(alloc)
p3 <- ggplot(alloc, aes(design, n, fill = used)) +
geom_col(width = 0.6) +
geom_text(aes(label = scales::comma(n)), vjust = -0.4, size = 3.5) +
facet_wrap(~parameter, scales = "free_y") +
scale_fill_manual(values = c(`TRUE` = "steelblue", `FALSE` = "grey65"), guide = "none") +
scale_y_continuous(labels = scales::comma, expand = expansion(mult = c(0, 0.12))) +
labs(x = NULL, y = "Respondents needed for a 5% half-width",
title = "Neyman allocation needs the fewest respondents for the mean",
subtitle = "The same allocation is the least efficient choice for the proportion") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 20, hjust = 1))
ggsave(file.path("figures", "B_allocation_comparison.png"), p3, width = 9, height = 4.5)
# ---- 4. Realised half-widths against the 5% target ------------------------
# Half-width of each repetition's 95% CI as a percentage of the true mean.
hw <- reps[reps$parameter == "Mean winnings", ]
hw$half_width_pct <- 100 * z * hw$se / hw$true
met <- aggregate(half_width_pct ~ design, hw, function(x) mean(x <= 100 * rel_e))
met$label <- paste0(round(100 * met$half_width_pct), "% of samples met the target")
p4 <- ggplot(hw, aes(half_width_pct, fill = design)) +
geom_histogram(binwidth = 0.05, alpha = 0.6, position = "identity") +
geom_vline(xintercept = 100 * rel_e, linetype = "dashed") +
geom_text(data = met, aes(x = 100 * rel_e, y = Inf, label = label, colour = design),
hjust = -0.05, vjust = c(2, 4), size = 3.5, inherit.aes = FALSE,
show.legend = FALSE) +
labs(x = "Half-width of 95% CI (% of true mean)", y = "Number of repetitions",
fill = "Design",
title = "Realised precision of the mean over 1,000 repetitions",
subtitle = "Dashed line = 5% target") +
theme_minimal()
ggsave(file.path("figures", "E_half_width_distribution.png"), p4, width = 7, height = 4.5)
# 06_extra_figures.R
# Four additional figures for the report:
#   A_winnings_by_region.png      - distribution of winnings by region (A5, A6)
#   A_banker_offer_curve.png      - banker offer as % of expected value (A5)
#   B_allocation_comparison.png   - n needed under each allocation (B5)
#   E_half_width_distribution.png - realised CI half-widths vs the 5% target (E, D8)
#
# Run 01 to 05 first; this script reads data/population.csv and
# output/E_replicates.csv. It draws no random numbers.
library(ggplot2)
population <- read.csv(file.path("data", "population.csv"))
reps       <- read.csv(file.path("output", "E_replicates.csv"))
N     <- nrow(population)
z     <- qnorm(0.975)
rel_e <- 0.05
dir.create("figures", showWarnings = FALSE)
# ---- 1. Winnings by region ------------------------------------------------
# Log scale, because winnings run from cents to over a million dollars.
# Diamonds mark each region's mean; crosses mark the opening expected value.
region_means <- aggregate(winnings_usd ~ region, population, mean)
opening_ev   <- unique(population[, c("region", "opening_ev_usd")])
p1 <- ggplot(population, aes(region, winnings_usd)) +
geom_violin(fill = "grey85", colour = NA, scale = "width") +
geom_boxplot(width = 0.15, outlier.size = 0.4, outlier.alpha = 0.3) +
geom_point(data = region_means, shape = 23, size = 3, fill = "steelblue") +
geom_point(data = opening_ev, aes(y = opening_ev_usd), shape = 4, size = 3,
stroke = 1.2, colour = "firebrick") +
# amounts under $1 keep their cents, so the bottom labels are not all "$0"
scale_y_log10(labels = function(x) ifelse(x < 1, paste0("$", x), scales::dollar(x)),
breaks = 10^(-2:6)) +
labs(x = "Region (stratum)", y = "Winnings (USD, log scale)",
title = "Distribution of winnings by region",
subtitle = "Blue diamond = mean winnings; red cross = opening expected value of the board") +
theme_minimal()
ggsave(file.path("figures", "A_winnings_by_region.png"), p1, width = 7, height = 4.5)
# ---- 2. Banker offer curve ------------------------------------------------
# Same rule as banker_fraction() in 01_simulate_population.R:
# base fraction 0.15 + 0.85 ((r - 1) / (R - 1))^1.5, multiplied by
# exp(N(0, 0.10^2)) noise and capped at 1.10. The band shows the middle 95%
# of that noise.
offer_curve <- function(show, R) {
r    <- seq_len(R)
base <- 0.15 + 0.85 * ((r - 1) / (R - 1))^1.5
data.frame(show  = show, round = r, base = base,
lower = base * exp(-z * 0.10),
upper = pmin(base * exp(z * 0.10), 1.10))
}
offers <- rbind(offer_curve("UK (6 rounds)", 6),
offer_curve("US and Australia (9 rounds)", 9))
p2 <- ggplot(offers, aes(round, base, colour = show, fill = show)) +
geom_ribbon(aes(ymin = lower, ymax = upper), alpha = 0.15, colour = NA) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
geom_hline(yintercept = 1, linetype = "dashed") +
scale_y_continuous(labels = scales::percent, limits = c(0, 1.15)) +
scale_x_continuous(breaks = 1:9) +
labs(x = "Round", y = "Offer as % of expected value of unopened boxes",
colour = "Show", fill = "Show",
title = "Banker offers rise towards the expected value as the game goes on",
subtitle = "Line = average offer; band = middle 95% of offers; dashed line = expected value") +
theme_minimal()
ggsave(file.path("figures", "A_banker_offer_curve.png"), p2, width = 7, height = 4.5)
# ---- 3. Required sample size under each allocation ------------------------
# For allocation shares a_h (n_h = n a_h), the variance of the stratified
# mean with fpc is  V = (1/n) sum W_h^2 S_h^2 / a_h - (1/N) sum W_h S_h^2,
# so the n that gives V = (e / z)^2 is
#   n = sum(W_h^2 S_h^2 / a_h) / ((e / z)^2 + sum(W_h S_h^2) / N).
strata <- do.call(rbind, lapply(split(population, population$region),
function(d) data.frame(
region = d$region[1],
N_h    = nrow(d),
S_h    = sd(d$winnings_usd),
Sp_h   = sqrt(nrow(d) / (nrow(d) - 1) * mean(d$below_ev) * (1 - mean(d$below_ev)))
)))
strata$W_h <- strata$N_h / N
n_alloc <- function(e, S_h, a_h) {
sum(strata$W_h^2 * S_h^2 / a_h) / ((e / z)^2 + sum(strata$W_h * S_h^2) / N)
}
n_srs <- function(e, S) {
n0 <- (z * S / e)^2
n0 / (1 + n0 / N)
}
# Allocation shares. The design uses Neyman allocation for the mean, so the
# proportion is shown under that same allocation.
shares <- list(
"Proportional"           = strata$W_h,
"Equal"                  = rep(1 / nrow(strata), nrow(strata)),
"Neyman for mean (used)" = strata$N_h * strata$S_h / sum(strata$N_h * strata$S_h)
)
e_mean <- rel_e * mean(population$winnings_usd)
e_prop <- rel_e * mean(population$below_ev)
S_p    <- sqrt(N / (N - 1) * mean(population$below_ev) * (1 - mean(population$below_ev)))
alloc <- rbind(
data.frame(parameter = "Mean winnings", design = "SRSWOR",
n = n_srs(e_mean, sd(population$winnings_usd))),
data.frame(parameter = "Mean winnings", design = names(shares),
n = sapply(shares, n_alloc, e = e_mean, S_h = strata$S_h)),
data.frame(parameter = "Proportion below opening EV", design = "SRSWOR",
n = n_srs(e_prop, S_p)),
data.frame(parameter = "Proportion below opening EV", design = names(shares),
n = sapply(shares, n_alloc, e = e_prop, S_h = strata$Sp_h))
)
alloc$n      <- ceiling(alloc$n)
alloc$design <- factor(alloc$design, levels = c("SRSWOR", names(shares)))
alloc$used   <- alloc$design == "Neyman for mean (used)"
print(alloc)
p3 <- ggplot(alloc, aes(design, n, fill = used)) +
geom_col(width = 0.6) +
geom_text(aes(label = scales::comma(n)), vjust = -0.4, size = 3.5) +
facet_wrap(~parameter, scales = "free_y") +
scale_fill_manual(values = c(`TRUE` = "steelblue", `FALSE` = "grey65"), guide = "none") +
scale_y_continuous(labels = scales::comma, expand = expansion(mult = c(0, 0.12))) +
labs(x = NULL, y = "Respondents needed for a 5% half-width",
title = "Neyman allocation needs the fewest respondents for the mean",
subtitle = "The same allocation is the least efficient choice for the proportion") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 20, hjust = 1))
ggsave(file.path("figures", "B_allocation_comparison.png"), p3, width = 9, height = 4.5)
# ---- 4. Realised half-widths against the 5% target ------------------------
# Half-width of each repetition's 95% CI as a percentage of the true mean.
hw <- reps[reps$parameter == "Mean winnings", ]
hw$half_width_pct <- 100 * z * hw$se / hw$true
met <- aggregate(half_width_pct ~ design, hw, function(x) mean(x <= 100 * rel_e))
met$label <- paste0(round(100 * met$half_width_pct), "% of samples met the target")
p4 <- ggplot(hw, aes(half_width_pct, fill = design)) +
geom_histogram(binwidth = 0.05, alpha = 0.6, position = "identity") +
geom_vline(xintercept = 100 * rel_e, linetype = "dashed") +
geom_text(data = met, aes(x = 100 * rel_e, y = Inf, label = label, colour = design),
hjust = -0.05, vjust = c(2, 4), size = 3.5, inherit.aes = FALSE,
show.legend = FALSE) +
labs(x = "Half-width of 95% CI (% of true mean)", y = "Number of repetitions",
fill = "Design",
title = "Realised precision of the mean over 1,000 repetitions",
subtitle = "Dashed line = 5% target") +
theme_minimal()
ggsave(file.path("figures", "E_half_width_distribution.png"), p4, width = 7, height = 4.5)
